#!/bin/sh
# Tracigo prepare-commit-msg hook
# Reads workspace metadata from .tracigo/workspace.local.md.
# Appends Tracigo trailers + copies artifacts for multi-repo workspaces.
# This script is generic — safe to commit. Workspace-specific values
# come from workspace.local.md (gitignored).

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# ── Chain with original hooks ──────────────────────────────────────────
HUSKY_HOOK='/Users/pushkarmandot/Documents/MyCompany/sdos/demo/multi-repo/Organica/.husky/prepare-commit-msg'
if [ -x "$HUSKY_HOOK" ]; then
  "$HUSKY_HOOK" "$@"
  HUSKY_EXIT=$?
  if [ $HUSKY_EXIT -ne 0 ]; then exit $HUSKY_EXIT; fi
fi

REPO_HOOK='/Users/pushkarmandot/Documents/MyCompany/sdos/demo/multi-repo/Organica/.git/hooks/prepare-commit-msg'
if [ -x "$REPO_HOOK" ]; then
  "$REPO_HOOK" "$@"
  REPO_EXIT=$?
  if [ $REPO_EXIT -ne 0 ]; then exit $REPO_EXIT; fi
fi

# ── Read workspace config ─────────────────────────────────────────────
# Look for config relative to the worktree root
WORKTREE_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
CONFIG=""
# Multi-repo: config is one level up from worktree
if [ -f "$WORKTREE_ROOT/../.tracigo/workspace.local.md" ]; then
  CONFIG="$WORKTREE_ROOT/../.tracigo/workspace.local.md"
# Single-repo: config is inside .tracigo/
elif [ -f "$WORKTREE_ROOT/.tracigo/workspace.local.md" ]; then
  CONFIG="$WORKTREE_ROOT/.tracigo/workspace.local.md"
fi

if [ -z "$CONFIG" ]; then
  exit 0  # Not an active Tracigo workspace — skip silently
fi

WORKSPACE_NAME=$(grep 'workspace_name:' "$CONFIG" | sed 's/.*: *//' | tr -d '"' | tr -d "'")
PROJECT_NAME=$(grep 'project_name:' "$CONFIG" | sed 's/.*: *//' | tr -d '"' | tr -d "'")
IS_MULTI_REPO=$(grep 'is_multi_repo:' "$CONFIG" | sed 's/.*: *//')
ARTIFACT_DIR=$(grep 'artifact_dir:' "$CONFIG" | sed 's/.*: *//' | tr -d '"' | tr -d "'")

# ── Copy workspace artifacts into repo (multi-repo only) ──────────────
if [ "$IS_MULTI_REPO" = "true" ] && [ -d "$ARTIFACT_DIR" ]; then
  SANITIZED=$(echo "$WORKSPACE_NAME" | sed 's/[/\\]/-/g' | sed 's/\.\.//g')
  REPO_TRACIGO_DIR="$WORKTREE_ROOT/.tracigo/$SANITIZED"
  mkdir -p "$REPO_TRACIGO_DIR"
  for f in "$ARTIFACT_DIR"/*.yaml "$ARTIFACT_DIR"/*.yml; do
    [ -e "$f" ] && cp "$f" "$REPO_TRACIGO_DIR"/ 2>/dev/null || true
  done
  git add .tracigo/ 2>/dev/null || true
fi

# ── Skip for merge/squash commits ─────────────────────────────────────
if [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "squash" ]; then
  exit 0
fi

# ── Append trailers (idempotent) ───────────────────────────────────────
if grep -q "^Tracigo-Workspace:" "$COMMIT_MSG_FILE" 2>/dev/null; then
  exit 0
fi

printf '\n\nTracigo-Workspace: %s\nTracigo-Project: %s\n' "$WORKSPACE_NAME" "$PROJECT_NAME" >> "$COMMIT_MSG_FILE"
